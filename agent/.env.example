# Copy to agent/.env (never commit it). Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=
# Model the agent runs on (default claude-opus-5-5)
AGENT_MODEL=claude-opus-5-5

# Dashboard / API
PORT=8787
# Staff password for the dashboard and admin API. If empty, admin routes only answer on localhost.
AGENT_ADMIN_TOKEN=
# Where enquiries, drafts and reports are stored
AGENT_DATA_DIR=./data
# Sites allowed to POST website enquiries to /api/leads (comma-separated)
AGENT_ALLOWED_ORIGINS=https://www.mediaiconsafrica.com,https://mediaiconsafrica.com,https://www.asiko.live,https://asiko.live,https://www.asiko.africa,https://asiko.africa,https://www.fastonafrica.com,https://fastonafrica.com

# WhatsApp Business Cloud API (optional) — receive enquiries and send approved replies
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# true = send replies to routine WhatsApp enquiries without waiting for approval (escalations always wait)
WHATSAPP_AUTO_SEND=false
